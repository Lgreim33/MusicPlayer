<Window x:Class="MusicPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MP3 Player" Height="450" Width="800">
    <Grid Background="#541789">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <!-- Sidebar -->
            <ColumnDefinition Width="*"/>
            <!-- Main Area -->
        </Grid.ColumnDefinitions>
        <DockPanel Width="200"
           Background="LightGray"
           DockPanel.Dock="Left">

            <!-- Add Playlist Button at the Bottom -->
            <Button Name="AddPlaylistButton"
            Content="Add Playlist"
            Margin="5"
            Padding="5"
            DockPanel.Dock="Bottom"
            Click="BtnAddPlaylist_Click"/>

            <!-- List of Playlists above -->
            <ListBox Name="PlaylistListBox"
         Margin="5"
         Background="#3E1165"
         ScrollViewer.VerticalScrollBarVisibility="Auto" SelectionChanged="playlist_selection_changed">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="#5A2D91"/>
                        <!-- A lighter purple -->
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Margin" Value="2"/>
                        <Setter Property="Padding" Value="5"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="#662288" 
                                BorderThickness="1"
                                CornerRadius="4">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#7A48B5"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#9F6CF3"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}">
                            <TextBlock.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Remove Playlist"
                                  Click="RemovePlaylist_Click"/>
                                    <MenuItem Header="Copy Path" 
                                  Click="CopyPath_Click"/>
                                </ContextMenu>
                            </TextBlock.ContextMenu>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Main Player Area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="100"/>
            </Grid.RowDefinitions>

 

            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20,0,10">
                <Image x:Name="CoverArt" Width="200" Height="200" Stretch="UniformToFill" Margin="0,0,0,10"/>
                <TextBlock x:Name="TextCurrentSongName" Text="Now Playing" Foreground="White" FontSize="16" HorizontalAlignment="Center"/>
            </StackPanel>
            <!-- Controls -->
            <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Margin="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <Button x:Name="BtnPrevious" Click="On_Last" Content="⏮" Width="50" Height="40" Margin="5" IsEnabled="False"/>
                    <Button x:Name="BtnPlayPause" Click="On_Play"  Content="▶" Width="60" Height="40" Margin="5" IsEnabled="False"/>
                    <Button x:Name="BtnNext" Click="On_Next" Content="⏭" Width="50" Height="40" Margin="5" IsEnabled="False"/>
                </StackPanel>

                <Slider x:Name="SliderProgress" Minimum="0" Maximum="100" Value="0"
                        TickFrequency="1" IsSnapToTickEnabled="True"/>
            </StackPanel>
            <MediaElement Name="currentSong"
              LoadedBehavior="Manual"
              MediaEnded="Element_MediaEnded"
              MediaOpened="Element_MediaOpened"/>
        </Grid>
    </Grid>
</Window>